# URL publique du site (utilisée pour le sitemap, les URLs canoniques et Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optionnel : webhook (Zapier, Make, n8n, CRM...) qui reçoit les demandes du formulaire de contact en JSON.
# Sans webhook, les demandes sont enregistrées localement dans data/.requests/ (serveur Node uniquement).
CONTACT_WEBHOOK_URL=
# Dossier du stockage modifiable (produits, réglages, compte admin, demandes, images envoyées).
# Par défaut : data/store. Sur un serveur, pointez vers un disque persistant et sauvegardé.
OBIRIN_STORE_DIR=
# Secret de signature des sessions admin (32 caractères minimum). Sans lui, un secret est généré
# automatiquement dans le dossier de stockage.
SESSION_SECRET=
# Envoi automatique des demandes sur WhatsApp via l'API officielle Meta (mode « API officielle Meta »
# dans /admin/reglages). Le mode CallMeBot, lui, se règle entièrement dans l'administration.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=nouvelle_demande
WHATSAPP_TEMPLATE_LANG=fr
# Création automatique du compte admin au premier démarrage (si aucun compte n'existe). Mot de passe : 10 caractères min.
# Retirez ADMIN_PASSWORD des variables une fois connecté.
ADMIN_USERNAME=
ADMIN_PASSWORD=
