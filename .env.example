# URL publique du site (utilisée pour le sitemap, les URLs canoniques et Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optionnel : webhook (Zapier, Make, n8n, CRM...) qui reçoit les demandes du formulaire de contact en JSON.
# Sans webhook, les demandes sont enregistrées localement dans data/.requests/ (serveur Node uniquement).
CONTACT_WEBHOOK_URL=
